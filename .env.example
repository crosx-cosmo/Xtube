# DATABASE_URL: Neon PostgreSQL connection string (serverless HTTP driver).
# Used for lightweight metadata, user email/password accounts, sessions, bookmarks, likes & comments.
# Example: postgresql://neondb_owner:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# NEON_AUTH_BASE_URL: (Optional) Managed Neon Auth (Better Auth) URL from Neon Console -> Project -> Branch -> Auth -> Settings.
# When set, Email & Password Sign Up / Sign In routes authenticate through Managed Neon Auth and sync users into Neon PostgreSQL.
# When omitted, Email & Password authentication runs directly against your Neon PostgreSQL `users` & `auth_sessions` tables via DATABASE_URL.
# Example: https://ep-cool-darkness-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=""

# NEON_AUTH_COOKIE_SECRET: (Optional) 32+ character random secret for Neon Auth session signing (e.g. `openssl rand -base64 32`).
NEON_AUTH_COOKIE_SECRET=""

# ADMIN_PASSCODE: Secret passcode required to unlock /admin for adding, editing, or deleting video links & thumbnails.
# Change this to a strong secret in production.
ADMIN_PASSCODE="kinship-admin-2026"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# =============================================================================
# NEON OBJECT STORAGE (Thumbnail Bucket: hey-lady)
# Copy AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, and AWS_SECRET_ACCESS_KEY
# from Neon Console -> Storage -> Bucket "hey-lady" -> Connect / Credentials.
# NOTE: AWS_ENDPOINT_URL_S3 uses the S3 storage host (*.storage.*.aws.neon.tech),
# which is different from the Neon Data API PostgREST URL (*.apirest.*/neondb/rest/v1).
# =============================================================================
NEON_STORAGE_BUCKET="hey-lady"
AWS_REGION="ap-southeast-1"
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Set to "true" ONLY if your `hey-lady` bucket access level is public_read.
# When "false" (default), thumbnails are served publicly via `/api/thumbnails/...`
# so visitors always see uploaded thumbnails even on private buckets.
NEON_STORAGE_PUBLIC_READ="false"

# Optional custom public CDN/domain base URL for `hey-lady` thumbnails.
NEON_STORAGE_PUBLIC_BASE_URL=""

# Optional reference for Neon Data API (PostgREST) endpoint if used separately.
NEON_DATA_API_URL=""

